{
  "permissions": {
    "allow": [
      "Bash(while IFS='=' read -r key value; do*)",
      "Bash(curl -s -G -u \"$JIRA_EMAIL:$JIRA_API_TOKEN\" *)",
      "Bash(curl -s -X GET -H \"Authorization: Bearer $CONFLUENCE_API_TOKEN\" *)",
      "Bash(curl -s -X POST -H \"Authorization: Bearer $CONFLUENCE_API_TOKEN\" *)",
      "Bash(curl -s -X PUT -H \"Authorization: Bearer $CONFLUENCE_API_TOKEN\" *)",
      "Bash(curl -s -X GET -H \"Authorization: Bearer $GITHUB_TOKEN\" *)",
      "Bash(curl -s -X POST -H \"Authorization: Bearer $GITHUB_TOKEN\" *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-prereqs.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-pipeline-stage.js"
          }
        ]
      }
    ]
  }
}
